{
  "Storage": {
    "Type": "AwsS3",
    "Bucket": "REPLACE_ME",
    "Region": "eu-north-1"
  },

  "Database": {
    "Type": "AwsDynamoDb",
    "TableName": "bagetter-packages",
    "Region": "eu-north-1"
  },

  "Search": {
    "Type": "AwsDynamoDb"
  },

  "PackageDeletionBehavior": "Unlist",
  "AllowPackageOverwrites": false,

  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "HealthCheck": {
    "Path": "/health"
  }
}
